{
	"name": "example-app",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"imports": {
		"#lib": "./src/lib",
		"#lib/*": "./src/lib/*",
		"#components/*": "./src/components/*"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch"
	},
	"devDependencies": {
		"@sveltejs/adapter-auto": "^8.0.0",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.0.0",
		"svelte": "^5.57.1",
		"svelte-check": "^4.0.0",
		"typescript": "^6.0.0",
		"vite": "^8.0.12"
	},
	"dependencies": {
		"@urql/core": "^5.1.1",
		"@urql/exchange-persisted": "^4.3.1",
		"deepmerge": "^4.3.1",
		"graphql": "^16.11.0"
	}
}
