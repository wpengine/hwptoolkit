    { "type": "fix", "section": "Bug Fixes" },
    { "type": "perf", "section": "Performance Improvements" },
    { "type": "revert", "section": "Reverts" },
    { "type": "deps", "section": "Dependencies" },
    { "type": "docs", "section": "Documentation", "hidden": true },
    { "type": "chore", "section": "Miscellaneous", "hidden": true },
    { "type": "refactor", "section": "Code Refactoring", "hidden": true },
    { "type": "test", "section": "Tests", "hidden": true },
    { "type": "build", "section": "Build System", "hidden": true },
    { "type": "ci", "section": "Continuous Integration", "hidden": true },
    { "type": "style", "section": "Styles", "hidden": true }
  ],
  "packages": {
    "plugins/hwp-documents": {
      "component": "@wpengine/hwp-documents-wordpress-plugin",
      "exclude-paths": ["plugins/hwp-documents/examples"]
    },
    "plugins/hwp-previews": {
      "component": "@wpengine/hwp-previews-wordpress-plugin",
      "exclude-paths": ["plugins/hwp-previews/examples"]
    },
    "plugins/wpgraphql-debug-extensions": {
      "component": "@wpengine/wpgraphql-debug-extensions-wordpress-plugin",
      "exclude-paths": ["plugins/wpgraphql-debug-extensions/examples"]
    },
    "plugins/wpgraphql-logging": {
      "component": "@wpengine/wpgraphql-logging-wordpress-plugin",
      "exclude-paths": ["plugins/wpgraphql-logging/examples"]
    },
    "plugins/wpgraphql-webhooks": {
      "component": "@wpengine/wpgraphql-webhooks-wordpress-plugin",
      "exclude-paths": ["plugins/wpgraphql-webhooks/examples"]
    }
  }
}
