{
  "phpVersion": "8.1",
  "plugins": [
    "https://downloads.wordpress.org/plugin/wp-graphql.zip",
    "https://github.com/wpengine/hwptoolkit/releases/download/%40wpengine%2Fwpgraphql-logging-wordpress-plugin-1.0.2/wpgraphql-logging.zip"
  ],
  "config": {
    "WP_DEBUG": true,
    "SCRIPT_DEBUG": false,
    "GRAPHQL_DEBUG": true,
    "WP_DEBUG_LOG": true,
    "WP_DEBUG_DISPLAY": false,
    "SAVEQUERIES": false
  },
  "mappings": {
    "db": "./wp-env/db",
    "wp-content/uploads": "./wp-env/uploads",
    ".htaccess": "./wp-env/setup/.htaccess"
  },
  "lifecycleScripts": {
    "afterStart": "wp-env run cli -- wp rewrite structure '/%postname%/' && wp-env run cli -- wp rewrite flush"
  }
}
