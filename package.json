      "nanoid@>=3.0.0 <3.3.18": "3.3.18",
      "postcss@>=8.0.0 <=8.5.22": "8.5.23",
      "svgo@>=3.0.0 <3.3.4": "3.3.4"
    }
  },
  "dependencies": {
    "remark-cli": "^12.0.1",
    "remark-frontmatter": "^5.0.0",
    "remark-preset-lint-recommended": "^7.0.1"
  }
